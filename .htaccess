# ----------------------------------------------------------------------
# 1. OPTIMIZACIÓN Y CACHÉ (Para que el cliente no pida los 58 archivos siempre)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
</IfModule>

# ----------------------------------------------------------------------
# 2. OPTIMIZACIÓN: COMPRESIÓN (Gzip)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    # Comprimir HTML, CSS, JavaScript, Texto y XML
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Deshabilitar el listado de archivos (Seguridad)
Options -Indexes

# ----------------------------------------------------------------------
# 2. MOTOR DE REESCRITURA
# ----------------------------------------------------------------------
RewriteEngine On

# A. Redireccionar a HTTPS (Siempre primero)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# B. EXCEPCIÓN CRÍTICA (ESTO EVITA EL ERROR 429)
# Si el navegador pide un archivo que EXISTE (como .js, .css o imágenes), 
# detiene las reglas aquí y lo entrega directamente sin despertar a PHP.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# C. REGLAS ESPECÍFICAS
# Redirecciona URL cron.php
RewriteRule ^cron\.php$ cron.php [NC,L,QSA]

# Redirecciona para pedidos
RewriteRule ^pedido/([^/]+)$ index.php?app=products&section=summary&order_id=$1 [NC,L,QSA]

# Redirecciona para rastreo
RewriteRule ^rastrear/([^/]+)$ index.php?app=products&section=order_tracking&order_id=$1 [NC,L,QSA]

# ----------------------------------------------------------------------
# 3. REGLAS GENERALES (Amigables)
# ----------------------------------------------------------------------

# Redirige raíz a la sección principal
RewriteRule ^$ index.php?app=home&section=null0 [NC,L,QSA]

# Redirige dominio.com/app/
RewriteRule ^([^/]+)/?$ index.php?app=$1&section=null0 [NC,L,QSA]

# Redirige dominio.com/app/seccion
RewriteRule ^([^/]+)/([^/]+)/?$ index.php?app=$1&section=$2 [NC,L,QSA]
